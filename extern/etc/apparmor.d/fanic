#include <tunables/global>

profile fanic flags=(attach_disconnected,mediate_deleted) {
  # Base runtime behavior for ELF/Python processes.
  #include <abstractions/base>
  #include <abstractions/python>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>

  # Allow local service networking and outbound calls.
  network unix,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  # Execute the app entrypoint and interpreter.
  /usr/bin/aa-exec ixr,
  /opt/fanic/.venv/bin/python rix,
  /home/fanic/.local/share/uv/python/** rix,
  /usr/bin/npm ixr,
  /usr/share/nodejs/npm/bin/npm-cli.js ixr,
  /usr/bin/node ixr,
  /usr/bin/nodejs ixr,
  /bin/sh ixr,
  /bin/dash ixr,
  /usr/bin/dash ixr,
  /opt/fanic/node_modules/.bin/tsc ixr,
  /opt/fanic/node_modules/typescript/bin/tsc ixr,

  # Read application code and dependencies.
  /opt/fanic/ r,
  /opt/fanic/** mr,
  /home/fanic/ r,
  /home/fanic/.local/ r,
  /home/fanic/.local/share/ r,
  /home/fanic/.local/share/uv/ r,
  /home/fanic/.local/share/uv/** mr,
  /home/fanic/.cache/ rw,
  /home/fanic/.cache/** rwk,
  /home/fanic/.npm/ rw,
  /home/fanic/.npm/** rwk,
  /home/fanic/.cache/clip/ rw,
  /home/fanic/.cache/clip/** rwkl,
  /usr/** mr,
  /etc/fanic/ r,
  /etc/fanic/credentials/ r,
  /etc/fanic/credentials/** r,
  /etc/ssl/** r,
  /etc/hosts r,
  /etc/hostname r,
  /etc/mime.types r,
  /etc/resolv.conf r,
  /etc/nsswitch.conf r,
  /etc/passwd r,
  /etc/group r,
  /proc/** r,
  /sys/fs/cgroup/** r,
  /sys/devices/system/cpu/kernel_max r,
  /sys/devices/system/cpu/present r,

  # Runtime write locations.
  /opt/fanic/runtime/ rw,
  /opt/fanic/runtime/** rwk,
  /opt/fanic/static/ rw,
  /opt/fanic/static/*.js rwk,
  /opt/fanic/static/*.js.map rwk,
  /run/fanic/ rw,
  /run/fanic/** rwk,
  /var/log/fanic/ rw,
  /var/log/fanic/** rwk,
  /dev/shm/ rw,
  /dev/shm/** rwkl,
  /tmp/ rw,
  /tmp/** rwk,
  /var/tmp/ rw,
  /var/tmp/** rwk,
  /mnt/storage/ rw,
  /mnt/storage/** rwk,

  # Keep interactive shell/tool execution restricted.
  deny /bin/bash x,
  deny /usr/bin/bash x,
  deny /bin/zsh x,
  deny /usr/bin/zsh x,
  deny /bin/fish x,
  deny /usr/bin/fish x,
}
