[Unit]
Description=FANIC moderation sidecar service
After=network.target

[Service]
Type=simple
User=fanic
Group=www-data
SupplementaryGroups=fanic
WorkingDirectory=/opt/fanic
Environment=PATH=/opt/fanic/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/fanic/src
EnvironmentFile=-/etc/fanic/fanic.env
Environment=FANIC_MODERATION_BIND_ADDR=unix:/run/fanic/fanic-moderation.sock
Environment=FANIC_MODERATION_WORKERS=2
# Environment=FANIC_MODERATION_SIDECAR_TOKEN_FILE=/etc/fanic/credentials/moderation_secret
ExecStartPre=/usr/bin/install -d -o fanic -g www-data -m 2775 /run/fanic
ExecStart=/usr/bin/env bash /opt/fanic/scripts/start-moderation-sidecar.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
MemoryMax=8G
ReadWritePaths=/mnt/storage /opt/fanic/runtime /var/log/fanic /run/fanic

[Install]
WantedBy=multi-user.target
